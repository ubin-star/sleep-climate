# Local configuration — contains SDK path, never commit
local.properties

# Release signing — keystore와 비밀번호는 절대 커밋하지 않음
keystore.properties
*.jks
*.keystore

# Android build outputs
*.apk
*.aab
build/
.gradle/

# 공모전 제출용 APK는 apk/ 폴더에만 커밋
!apk/
!apk/*.apk

# 로컬 작업 기록·발표 준비 메모
.agents/
.specstory/
.cursorindexingignore
prep/

# IDE files
*.iml
.idea/
.DS_Store

# Kotlin incremental compilation
**/*.kotlin_module
