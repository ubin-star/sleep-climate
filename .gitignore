# Local configuration — contains SDK path, never commit
local.properties

# Release signing — keystore와 비밀번호는 절대 커밋하지 않음
keystore.properties
*.jks
*.keystore

# Android build outputs
*.apk
*.aab
build/
.gradle/

# 공모전 제출용 APK는 apk/ 폴더에만 커밋
!apk/
!apk/*.apk

# AI 작업 기록 (클라이언트 시크릿 등 민감 정보 포함 가능)
.agents/
.specstory/
.cursorindexingignore

# IDE files
*.iml
.idea/
.DS_Store

# Kotlin incremental compilation
**/*.kotlin_module
