<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Connect / Android Automotive OS 차량용 앱 선언 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- 위치 정보 (FusedLocation SDK 사용 시) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 네트워크 상태 확인 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 포그라운드 서비스 (세션 유지) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- 알림 권한 (API 33+, minSdk=28이므로 런타임 요청도 병행) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 세션 중 CPU/화면 절전 방지 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- TODO: Vehicle SDK 공조 제어 권한 - 실제 권한명은 SDK 문서 확인 후 추가 -->
    <!-- <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" /> -->

    <application
        android:name=".SleepClimateApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SleepClimate"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Pleos Connect SDK 인증 정보 -->
        <!-- 프로젝트 ID: 314de939-581c-4f72-9a20-3b3deb887307 -->
        <meta-data
            android:name="ai.pleos.connect.CLIENT_ID"
            android:value="HjGgahiwRkOVR-DTI2AE5w" />

        <!-- 메인 액티비티 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 세션 포그라운드 서비스 -->
        <service
            android:name=".data.session.SessionForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|connectedDevice" />

    </application>

</manifest>
